    "m_FunctionSource": "01fedd2b91156b64eb031b47097e03ee",
    "m_FunctionBody": "CoC = |Aperture * (((PlaneInFocus * ImageDistance)/(PlaneInFocus + ImageDistance) *(PlaneInFocus - ImageDistance))/(ImageDistance * (PlaneInFocus - (PlaneInFocus * ImageDistance)/(PlaneInFocus + ImageDistance))))|;"
}

